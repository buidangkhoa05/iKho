{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "// NOTE": "Placeholder values until an identity provider is selected. Authentication is registered but no routes require it yet.",
    "Authority": "",
    "Audience": ""
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 10,
    "QueueLimit": 0
  },
  "Cors": {
    "// NOTE": "Fill in production origins before deploying.",
    "AllowedOrigins": []
  },
  "ReverseProxy": {
    "Routes": {
      "shared-library-route": {
        "ClusterId": "shared-library-cluster",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "shared-library-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5143"
          }
        }
      }
    }
  }
}
