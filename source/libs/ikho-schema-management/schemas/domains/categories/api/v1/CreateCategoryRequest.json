{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CreateCategoryRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["categoryId", "name", "isActive", "createdOn"],
  "properties": {
    "categoryId": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": ["string", "null"]
    },
    "parentCategoryId": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "isActive": {
      "type": "boolean"
    },
    "createdOn": {
      "type": "string",
      "format": "date-time"
    }
  }
}
