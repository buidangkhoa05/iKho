{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CreateProductRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["productId", "sku", "name", "price", "isActive", "createdOn"],
  "properties": {
    "productId": {
      "type": "string",
      "format": "uuid"
    },
    "sku": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": ["string", "null"]
    },
    "categoryId": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "price": {
      "type": "number",
      "minimum": 0
    },
    "isActive": {
      "type": "boolean"
    },
    "createdOn": {
      "type": "string",
      "format": "date-time"
    }
  }
}
