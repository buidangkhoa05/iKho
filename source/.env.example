# Copy to `.env` (gitignored) in this directory and fill in real values for local
# docker-compose runs. docker-compose.yml reads this file automatically.
#
# Frontend Docker build only reads this via `pnpm nx docker-build ikho-ui` if you pass
# --build-arg NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY yourself; the Vercel deployment and the
# GitHub Actions image publish each get this value from their own separate env/secret store.

# Clerk instance's Frontend API URL — Clerk dashboard > Configure > API keys > "Frontend API URL".
# Safe to share, not a secret.
JWT_AUTHORITY=

# Only set if a custom Clerk JWT template defines a fixed audience claim. Leave blank
# to skip audience validation (the default Clerk session token has none).
JWT_AUDIENCE=

# Clerk dashboard > Configure > API keys > Secret keys. Keep this out of git and chat.
CLERK_SECRET_KEY=

# Clerk dashboard > Configure > Developers > Webhooks > (your endpoint) > Signing Secret.
# Only exists once a webhook endpoint is configured. Keep this out of git and chat.
CLERK_WEBHOOK_SIGNING_SECRET=
